# Example Environment Configuration for Local Development
# Copy these values into your environment or shell:

# MySQL Database credentials
DB_URL=jdbc:mysql://localhost:3306/medical_appointment_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# JWT Secret (minimum 256 bits)
JWT_SECRET=CarePulseMedicalSecretKey2026SecureLongTokenStringForHmacSha256!
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173
